{
    "name": "beziworld/laravel-comfino",
    "description": "ComfinoPay installments and buy now, pay later for Laravel: financial products, loan applications, cancellation, CR-Signature status webhooks and widget helpers.",
    "keywords": [
        "laravel",
        "comfino",
        "comfinopay",
        "installments",
        "raty",
        "bnpl",
        "buy-now-pay-later",
        "payments",
        "poland"
    ],
    "homepage": "https://github.com/beziworld/laravel-comfino",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-comfino/issues",
        "source": "https://github.com/beziworld/laravel-comfino"
    },
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\Comfino\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\Comfino\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\Comfino\\ComfinoServiceProvider"
            ],
            "aliases": {
                "Comfino": "Beziworld\\Comfino\\Facades\\Comfino"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
